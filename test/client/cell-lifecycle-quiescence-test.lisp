;;;; Observed shell quiescence, real off-loop workers and profile handover.
;;;; SPDX-License-Identifier: MIT
(in-package #:nodecode.test)

(defun shell-quiescence-wait (predicate &optional (seconds 2))
  (let ((deadline (+ (get-internal-real-time) (* seconds internal-time-units-per-second))))
    (loop when (funcall predicate) return t
          when (> (get-internal-real-time) deadline) return nil
          do (sleep 0.005))))

(defun shell-quiescence-pending (manager)
  (bt2:with-lock-held ((nle::shell-cell-manager-lock manager))
    (nle::shell-cell-manager-pending manager)))

(defun shell-quiescence-program (model)
  (let ((program (nlt:make-program model)))
    (setf (nle::chat-model-program model) program
          (nlt:program-running program) t)
    program))

(deftest shell-stop-refusal-is-false-retains-owner-and-stops-siblings (with-shell-cell-fixture (model))
  (let* ((manager (nle::shell-cell-manager-for model t)) (fail t) (good nil))
    (setf (nle::shell-cell-manager-running manager)
          (list (cons "bad" (lambda () (when fail (error "still draining"))))
                (cons "good" (lambda () (setf good t)))))
    (handler-bind ((warning #'muffle-warning))
      (multiple-value-bind (quiet reason) (nle::stop-shell-cells model)
        (is (not quiet))
        (is (equal '("bad") (getf reason :cells)))))
    (is good)
    (is (eq manager (nle::shell-cell-manager-for model)))
    (setf fail nil)
    (is (nle::stop-shell-cells model))
    (is (null (nle::shell-cell-manager-for model)))))

(deftest shell-exit-counts-real-off-loop-load-and-cleans-independent-resources (with-shell-cell-fixture (model))
  (let* ((program (shell-quiescence-program model))
         (manager (nle::shell-cell-manager-for model t))
         (entered (bt2:make-semaphore)) (release (bt2:make-semaphore)) (good nil))
    (unwind-protect
         (progn
           (setf (nle::shell-cell-manager-running manager)
                 (list (cons "independent" (lambda () (setf good t)))))
           (setf (symbol-function 'nlk:load-cell)
                 (lambda (&rest names)
                   (declare (ignore names))
                   (bt2:signal-semaphore entered)
                   (bt2:wait-on-semaphore release)))
           (nlt:update model
                       (make-instance 'nle::gw-projection-msg
                         :frame (nlk:decode-sync-message
                                 (nlk:encode-unsequenced-frame
                                  "organism.cells" (nlk:json-object "names" #("nodecode-shell-demo")
                                                                   "action" "start")))))
           (is (bt2:wait-on-semaphore entered :timeout 2))
           (is (= 1 (shell-quiescence-pending manager)))
           (multiple-value-bind (quiet reason) (nle::stop-shell-cells model :timeout 0.02)
             (is (not quiet))
             (is (= 1 (getf reason :pending))))
           (is good)
           (is (eq manager (nle::shell-cell-manager-for model)))
           (bt2:signal-semaphore release)
           (is (shell-quiescence-wait (lambda () (zerop (shell-quiescence-pending manager)))))
           (is (null *shell-demo-log*))
           ;; The real OFF-LOOP worker completed without the UI consuming this
           ;; continuation. A stopped loop cannot hold lifecycle ownership.
           (let ((messages (nlt::mailbox-drain (nlt::program-mailbox program) :timeout 1)))
             (is (find-if (lambda (message) (typep message 'nle::off-loop-msg)) messages))
             (dolist (message messages)
               (when (typep message 'nle::off-loop-msg) (nlt:update model message))))
           (is (nle::stop-shell-cells model :timeout 0.02))
           (is (null (nle::shell-cell-manager-for model))))
      (bt2:signal-semaphore release)
      (shell-quiescence-wait (lambda () (zerop (shell-quiescence-pending manager))))
      (setf (nlt:program-running program) nil))))

(deftest shell-dispatch-failure-releases-the-pre-dispatch-pending-slot (with-shell-cell-fixture (model))
  (with-stubbed-fdefinition (nle::off-loop (target thunk continuation)
                             (declare (ignore thunk continuation))
                             (is (= 1 (shell-quiescence-pending (nle::shell-cell-manager-for target))))
                             (error "dispatch refused"))
    (is (signals-error error (nle::start-shell-cells model))))
  (is (zerop (shell-quiescence-pending (nle::shell-cell-manager-for model))))
  (is (nle::stop-shell-cells model :timeout 0)))

(deftest shell-worker-error-unwinds-pending-without-a-mailbox-consumer (with-shell-cell-fixture (model))
  (let ((program (shell-quiescence-program model)))
    (unwind-protect
         (with-stubbed-fdefinition (nle::read-shared-config () (error "config unavailable"))
           (let ((manager (nle::start-shell-cells model)))
             (is (shell-quiescence-wait (lambda () (zerop (shell-quiescence-pending manager)))))
             (is (nle::stop-shell-cells model :timeout 0))))
      (setf (nlt:program-running program) nil))))

(deftest shell-off-needs-no-config-and-runs-existing-inverse (with-shell-cell-fixture (model))
  (let ((manager (nle::start-shell-cells model))
        (program (shell-quiescence-program model)) (reads 0))
    (unwind-protect
         (with-stubbed-fdefinition (nle::read-shared-config ()
                                    (incf reads) (error "config unavailable"))
           (nle::request-shell-cell-action model '("nodecode-shell-demo") "stop")
           (is (shell-quiescence-wait (lambda () (zerop (shell-quiescence-pending manager)))))
           (is (zerop reads))
           (is (null (nle::shell-cell-manager-running manager)))
           (is (= 1 (count (list :shell-stop model) *shell-demo-log* :test #'equal)))
           (is (zerop (hash-table-count (nle::shell-cell-manager-failures manager)))))
      (setf (nlt:program-running program) nil))))

(deftest shell-sync-config-failure-does-not-block-removals (with-shell-cell-fixture (model))
  (let ((manager (nle::start-shell-cells model))
        (program (shell-quiescence-program model)) (reads 0))
    (unwind-protect
         (with-stubbed-fdefinition (nle::read-shared-config ()
                                    (incf reads) (error "config unavailable"))
           (nle::request-shell-cell-action model '("new-a" "new-b") "sync")
           (is (shell-quiescence-wait (lambda () (zerop (shell-quiescence-pending manager)))))
           (is (= 1 reads))
           (is (null (nle::shell-cell-manager-running manager)))
           (is (= 1 (count (list :shell-stop model) *shell-demo-log* :test #'equal)))
           (is (null (gethash "nodecode-shell-demo" (nle::shell-cell-manager-failures manager))))
           (dolist (name '("new-a" "new-b"))
             (is (search "config unavailable"
                         (or (gethash name (nle::shell-cell-manager-failures manager)) "")))))
      (setf (nlt:program-running program) nil))))

(deftest shell-old-load-failure-cannot-replace-newer-success (with-shell-cell-fixture (model))
  (let* ((program (shell-quiescence-program model)) (count 0)
         (entered (bt2:make-semaphore)) (release (bt2:make-semaphore)) (manager nil))
    (unwind-protect
         (progn
           (setf (symbol-function 'nlk:load-cell)
                 (lambda (&rest names)
                   (declare (ignore names))
                   (when (= 1 (incf count))
                     (bt2:signal-semaphore entered)
                     (bt2:wait-on-semaphore release)
                     (error "old generation failed"))))
           (setf manager (nle::start-shell-cells model))
           (is (bt2:wait-on-semaphore entered :timeout 2))
           (nle::request-shell-cell-action model '("nodecode-shell-demo") "start")
           (is (shell-quiescence-wait (lambda () (= 1 (shell-quiescence-pending manager)))))
           (is (= 1 (length (nle::shell-cell-manager-running manager))))
           (bt2:signal-semaphore release)
           (is (shell-quiescence-wait (lambda () (zerop (shell-quiescence-pending manager)))))
           (is (null (gethash "nodecode-shell-demo" (nle::shell-cell-manager-failures manager))))
           (is (nle::stop-shell-cells model)))
      (bt2:signal-semaphore release)
      (when manager (shell-quiescence-wait (lambda () (zerop (shell-quiescence-pending manager)))))
      (setf (nlt:program-running program) nil))))

(deftest shell-current-failure-remains-visible-but-closed-request-failure-does-not (with-shell-cell-fixture (model))
  (let ((manager (nle::shell-cell-manager-for model t)))
    (setf (gethash "demo" (nle::shell-cell-manager-desired manager)) (cons 2 t))
    (handler-bind ((warning #'muffle-warning))
      (nle::shell-cell-failure manager "demo" "current" 2))
    (is (equal "current" (gethash "demo" (nle::shell-cell-manager-failures manager))))
    (nle::shell-cell-failure manager "demo" "obsolete" 1)
    (is (equal "current" (gethash "demo" (nle::shell-cell-manager-failures manager))))
    (setf (nle::shell-cell-manager-closed manager) t)
    (nle::shell-cell-failure manager "demo" "late" 2)
    (is (equal "current" (gethash "demo" (nle::shell-cell-manager-failures manager))))))

(deftest shell-profile-handover-refuses-after-independent-teardown (with-shell-cell-fixture (model))
  (let ((order nil) (program (nlt:make-program nil))
        (manager (nle::shell-cell-manager-for model t))
        (nlk::*profile-switch-parked* nil) (nlt:*keep-terminal* nil)
        (*error-output* (make-string-output-stream)))
    (setf (nle::shell-cell-manager-running manager)
          (list (cons "bad" (lambda () (error "still draining")))))
    (with-stubbed-fdefinition (nlk:close-store () (push :store order))
      (with-saved-globals ((nlk::*profile-switch-performer*
                            (lambda (&rest ignored) (declare (ignore ignored)) (push :exec order))))
        (handler-bind ((warning #'muffle-warning))
          (is (eq :shell-result
                  (nle::call-with-profile-switch
                   program
                   (lambda ()
                     (funcall nlk::*profile-switch-performer* "other" "private-nodecode" nil)
                     (nle::note-shell-cell-shutdown model)
                     (push :connection-closed order)
                     (push :presence-closed order)
                     :shell-result)))))))
    (is (equal '(:presence-closed :connection-closed) order))
    (is (null nlk::*profile-switch-parked*))
    (is (null nlt:*keep-terminal*))
    (is (search "profile handover refused" (get-output-stream-string *error-output*)))
    (is (eq manager (nle::shell-cell-manager-for model)))
    (setf (nle::shell-cell-manager-running manager) nil)))

(deftest shell-profile-handover-proceeds-only-after-successful-cleanup (with-shell-cell-fixture (model))
  (let ((order nil) (program (nlt:make-program nil))
        (manager (nle::shell-cell-manager-for model t))
        (nlk::*profile-switch-parked* nil) (nlt:*keep-terminal* nil))
    (setf (nle::shell-cell-manager-running manager)
          (list (cons "good" (lambda () (push :cell-stopped order)))))
    (with-stubbed-fdefinition (nlk:close-store () (push :store-closed order))
      (with-saved-globals ((nlk::*profile-switch-performer*
                            (lambda (&rest ignored) (declare (ignore ignored)) (push :exec order) nil)))
        (nle::call-with-profile-switch
         program
         (lambda ()
           (funcall nlk::*profile-switch-performer* "other" "private-nodecode" nil)
           (is (nle::note-shell-cell-shutdown model))
           (push :connection-closed order)))))
    (is (equal '(:cell-stopped :connection-closed :store-closed :exec) (reverse order)))))

(deftest shell-shutdown-unexpected-error-is-not-thrown-past-other-cleanup ()
  (let ((nle::*shell-teardown-refusal* nil) (continued nil))
    (with-stubbed-fdefinition (nle::stop-shell-cells (model &key timeout)
                               (declare (ignore model timeout)) (error "unexpected drain error"))
      (is (not (nle::note-shell-cell-shutdown nil)))
      (setf continued t))
    (is continued)
    (is (search "unexpected drain error" nle::*shell-teardown-refusal*))))

(deftest shell-non-error-dispatch-unwind-releases-owned-pending-slot (with-shell-cell-fixture (model))
  (with-stubbed-fdefinition (nle::off-loop (target thunk continuation)
                             (declare (ignore target thunk continuation))
                             (throw 'schedule-aborted :aborted))
    (is (eq :aborted (catch 'schedule-aborted (nle::start-shell-cells model)))))
  (is (zerop (shell-quiescence-pending (nle::shell-cell-manager-for model))))
  (is (nle::stop-shell-cells model :timeout 0)))

(deftest shell-exit-during-real-worker-acquisition-retains-owner-until-drained (with-shell-cell-fixture (model))
  (let* ((program (shell-quiescence-program model))
         (saved (symbol-function 'nodecode-shell-demo::start-shell-cell))
         (entered (bt2:make-semaphore)) (release (bt2:make-semaphore)) (manager nil))
    (unwind-protect
         (progn
           (setf (symbol-function 'nodecode-shell-demo::start-shell-cell)
                 (lambda (config target)
                   (let ((stop (funcall saved config target)))
                     (bt2:signal-semaphore entered)
                     (bt2:wait-on-semaphore release)
                     stop)))
           (setf manager (nle::start-shell-cells model))
           (is (bt2:wait-on-semaphore entered :timeout 2))
           (is (= 1 (shell-quiescence-pending manager)))
           (multiple-value-bind (quiet reason) (nle::stop-shell-cells model :timeout 0.02)
             (is (not quiet))
             (is (getf reason :resources-busy)))
           (is (eq manager (nle::shell-cell-manager-for model)))
           (bt2:signal-semaphore release)
           (is (shell-quiescence-wait (lambda () (zerop (shell-quiescence-pending manager)))))
           (is (= 1 (count (list :shell-stop model) *shell-demo-log* :test #'equal)))
           (is (nle::stop-shell-cells model :timeout 0))
           (is (null (nle::shell-cell-manager-for model))))
      (bt2:signal-semaphore release)
      (when manager (shell-quiescence-wait (lambda () (zerop (shell-quiescence-pending manager)))))
      (setf (symbol-function 'nodecode-shell-demo::start-shell-cell) saved
            (nlt:program-running program) nil))))
